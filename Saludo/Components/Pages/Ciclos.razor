@page "/ciclos"
@rendermode InteractiveServer
<h3>Ciclos</h3>
<div class="row mb-3">
    <div class="col-2">
        <label class="col-form-label" for="txtNumero">Calificación</label>
    </div>
    <div class="col-auto">
        <input class="form-control" id="txtNumero" @bind="numero" />
    </div>
</div>
<button class="btn btn-primary mb-3" @onclick="Ejecutar">Guardar</button>
<button class="btn btn-danger mb-3" @onclick="Eliminar">Eliminar</button>
<button class="btn btn-info mb-3" @onclick="Buscar">Buscar</button>
<hr />
<h3>Calificaciones capturadas: @calificaciones.Count</h3>
<hr />
<h3>@mensaje</h3>
<hr />
<table class="table table-striped">
    <thead>
        <tr>
            <th>Calificación</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < calificaciones.Count; i++)
        {
            int indice = i;
            <tr>
                <td>@calificaciones[indice]</td>
                <td><button class="btn btn-sm btn-danger" @onclick="() => calificaciones.RemoveAt(indice)">Eliminar</button></td>
            </tr>
        }

        @*         @foreach (int valor in calificaciones)
        {
            <tr><td>@valor</td></tr>
        }
 *@
    </tbody>
</table>


